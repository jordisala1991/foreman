#!/usr/bin/env python3
"""foreman's developer tools: `dev/foreman-dev [--project P] stats|fill|timeline|snapshot …` (dev/README.md).

Not part of the product: it puts foreman's lib/ and this folder on sys.path and runs foreman_dev.cli. It only reads,
but for `snapshot`, which writes into the empty folder it is given.
"""

import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path[:0] = [os.path.join(os.path.dirname(HERE), "lib"), HERE]

from foreman_dev.cli import main  # noqa: E402

sys.exit(main())
