"""Only for launchd plists written before the command was renamed: their launcher runs `<installPath>/bin/fm`.

Not executable on purpose (no shell runs it as a command, so `fm` stays macOS's /usr/bin/fm). It is deleted once
`foreman launchd` has been re-run and the jobs reloaded."""
import os
import sys
from pathlib import Path

foreman = Path(__file__).resolve().with_name("foreman")
os.execv(sys.executable, [sys.executable, str(foreman), *sys.argv[1:]])
