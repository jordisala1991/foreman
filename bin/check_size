#!/usr/bin/env python3
"""Size rules, with no exceptions: no file in fm/ or panel/src over `limit` lines (tests: `tests_limit`), both in pyproject.toml
[tool.fm-size], and no `noqa` in fm/ that silences a size or complexity rule (C901, PLR09xx): ruff checks the functions, and this
keeps anyone from turning that check off one function at a time. A rule that fires is a design signal: refactor.
"""

import re
import sys
import tomllib
from pathlib import Path

CODE = (".py", ".ts", ".tsx", ".css")
SILENCED = re.compile(r"noqa:.*\b(C901|PLR09\d\d)\b")


def lines(path: Path) -> int:
    return len(path.read_text(encoding="utf-8").splitlines())


def check(root: Path) -> list[str]:
    cfg = tomllib.loads((root / "pyproject.toml").read_text(encoding="utf-8"))["tool"]["fm-size"]
    rules = [("fm", cfg["limit"]), ("panel/src", cfg["limit"]), ("tests", cfg["tests_limit"])]
    problems: list[str] = []
    for folder, limit in rules:
        for f in sorted((root / folder).rglob("*")):
            if not f.is_file() or f.suffix not in CODE or "__pycache__" in f.parts:
                continue
            rel, n = f.relative_to(root).as_posix(), lines(f)
            if n > limit:
                problems.append(f"{rel}: {n} lines, over the limit of {limit}")
            if f.suffix == ".py" and folder == "fm":
                for num, ln in enumerate(f.read_text(encoding="utf-8").splitlines(), 1):
                    if SILENCED.search(ln):
                        problems.append(f"{rel}:{num}: a size/complexity rule is silenced with noqa; refactor instead")
    return problems


def main() -> None:
    root = Path(sys.argv[1]) if len(sys.argv) > 1 else Path(__file__).resolve().parent.parent
    problems = check(root)
    for line in problems:
        print(line, file=sys.stderr)
    sys.exit(1 if problems else 0)


main()
