#!/usr/bin/env python3
"""File-size check: no file in fm/ or panel/src over its limit (a ratchet: exceptions may shrink, never grow).

Limits live in pyproject.toml, [tool.fm-size]: `limit` (default for the code), `tests_limit`, and `[tool.fm-size.exceptions]`,
path = lines allowed. An exception whose file is now under the plain limit is stale and fails too: delete it.
"""

import sys
import tomllib
from pathlib import Path

CODE = (".py", ".ts", ".tsx", ".css")


def lines(path: Path) -> int:
    return len(path.read_text(encoding="utf-8").splitlines())


def check(root: Path) -> list[str]:
    cfg = tomllib.loads((root / "pyproject.toml").read_text(encoding="utf-8"))["tool"]["fm-size"]
    exceptions: dict[str, int] = cfg.get("exceptions", {})
    rules = [("fm", cfg["limit"]), ("panel/src", cfg["limit"]), ("tests", cfg["tests_limit"])]
    problems: list[str] = []
    seen: set[str] = set()
    for folder, limit in rules:
        for f in sorted((root / folder).rglob("*")):
            if not f.is_file() or f.suffix not in CODE or "__pycache__" in f.parts:
                continue
            rel, n = f.relative_to(root).as_posix(), lines(f)
            allowed = exceptions.get(rel, limit)
            seen.add(rel)
            if n > allowed:
                problems.append(f"{rel}: {n} lines, over its limit of {allowed}")
            elif rel in exceptions and n <= limit:
                problems.append(f"{rel}: {n} lines is under {limit} now; remove it from the exceptions")
    problems += [f"{rel}: exception for a file that does not exist" for rel in exceptions if rel not in seen]
    return problems


def main() -> None:
    root = Path(sys.argv[1]) if len(sys.argv) > 1 else Path(__file__).resolve().parent.parent
    problems = check(root)
    for line in problems:
        print(line, file=sys.stderr)
    sys.exit(1 if problems else 0)


main()
