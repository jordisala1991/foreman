#!/usr/bin/env python3
"""gh, as the agents see it: bin/ is first on their PATH, so this counts the call (who spends GitHub's quota: fm/ghcalls.py)
and runs the real gh. The count never gets in the way: if it fails, gh still runs."""
import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
try:
    sys.path.insert(0, str(HERE.parent))
    from fm import ghcalls
    from fm.config import Project

    ghcalls.record(Project.load(os.environ["FM_HOME"]))
except Exception as e:
    print(f"fm gh: call not counted: {e}", file=sys.stderr)

for d in os.environ.get("PATH", "").split(os.pathsep):
    real = Path(d, "gh")
    if d and Path(d).resolve() != HERE and real.is_file() and os.access(real, os.X_OK):
        os.execv(real, ["gh", *sys.argv[1:]])
print("fm gh: the real gh is not on PATH", file=sys.stderr)
sys.exit(127)
