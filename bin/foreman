#!/bin/sh
# foreman: the single entry point (see `foreman --help`). Every hook and every CLI call runs this POSIX sh launcher.
#
# It finds a Python of at least min_python and execs foreman's Python entry with it (lib/main.py; nothing else runs
# foreman's code). Where it looks, in order: $FOREMAN_PYTHON, python3 and python3.N on the PATH, mise
# ($MISE_DATA_DIR or ~/.local/share/mise), Homebrew (/opt/homebrew/bin, /usr/local/bin) and /usr/bin/python3.
# When no Python fits, foreman is never silent:
#   hook guard   denies the tool call (exit 2, the reason on stderr) when a foreman registry exists, since its
#                guard and the owner's never-without-me list cannot run; without a registry (no product set up) it
#                exits 0;
#   hook who     (SessionStart) prints a systemMessage for the owner and a line for the model, except on compact;
#   other hooks  exit 0 (a hook never breaks a session) with a line on stderr;
#   the CLI      prints the reason on stderr and exits 1.
# Keep it POSIX sh (no bashisms) and without external commands other than the Pythons it tries.

min_python=3.9  # the one place that says which Python foreman needs

want_major=${min_python%%.*}
want_minor=${min_python#*.}
newest_minor=20
found=""

fits() {  # $1: an interpreter; true when it runs and is at least min_python (else remembers the newest too old)
  [ -n "$1" ] && [ -f "$1" ] && [ -x "$1" ] || return 1
  v=$("$1" -V 2>&1) || return 1  # "Python 3.11.4"
  case "$v" in "Python "*) v=${v#Python } ;; *) return 1 ;; esac
  major=${v%%.*}
  minor=${v#*.}
  minor=${minor%%[!0-9]*}
  case "$major:$minor" in *[!0-9:]*|:*|*:) return 1 ;; esac
  if [ "$major" -gt "$want_major" ] || { [ "$major" -eq "$want_major" ] && [ "$minor" -ge "$want_minor" ]; }; then
    return 0
  fi
  if [ -z "$found" ] || [ "$major" -gt "${found%%.*}" ] || \
    { [ "$major" -eq "${found%%.*}" ] && [ "$minor" -gt "${found#*.}" ]; }; then
    found="$major.$minor"
  fi
  return 1
}

pick() {  # sets py to the first interpreter that fits
  for py in "${FOREMAN_PYTHON:-}" "$(command -v python3)"; do fits "$py" && return 0; done
  n=$newest_minor
  while [ "$n" -ge "$want_minor" ]; do
    py=$(command -v "python$want_major.$n") && fits "$py" && return 0
    n=$((n - 1))
  done
  if [ -n "${HOME:-}" ]; then
    for py in "${MISE_DATA_DIR:-$HOME/.local/share/mise}"/installs/python/*/bin/python3; do
      fits "$py" && return 0
    done
  fi
  for dir in /opt/homebrew/bin /usr/local/bin; do
    for py in "$dir/python3" "$dir"/python3.[0-9] "$dir"/python3.[0-9][0-9]; do fits "$py" && return 0; done
  done
  py=/usr/bin/python3
  fits "$py"
}

here=$0
while [ -L "$here" ]; do  # a link to this file (e.g. in ~/.local/bin): follow it to the plugin's own bin/
  link=$(readlink "$here") || break
  case "$link" in /*) here=$link ;; *) here=${here%/*}/$link ;; esac
done
case "$here" in */*) root=${here%/*}/.. ;; *) root=.. ;; esac

# The entry checks the version it is told (FOREMAN_PYTHON_MIN) before anything else. Fast path, as cheap as a plain
# `#!/usr/bin/env python3`: without FOREMAN_PYTHON, the PATH's python3 runs without being asked its version first;
# when it is too old the entry runs this launcher again with FOREMAN_PYTHON_PROBE=1, and then every candidate is
# asked (`python -V`, ~3 ms each).
export FOREMAN_PYTHON_MIN="$min_python"
if [ -z "${FOREMAN_PYTHON_PROBE:-}" ] && [ -z "${FOREMAN_PYTHON:-}" ] && py=$(command -v python3); then
  exec "$py" "$root/lib/main.py" "$@"
fi
if pick; then
  exec "$py" "$root/lib/main.py" "$@"
fi

why="foreman needs Python $min_python or newer and found none${found:+ (the newest found is $found)}"
how="Install one (macOS: xcode-select --install, brew install python@3.13 or mise use -g python@3.13; Linux: your"
how="$how package manager),"
how="$how or set FOREMAN_PYTHON to its path; then restart the Claude Code session."
blocks="foreman blocks every Bash, Write and Edit call while its registry exists"

if [ "${1:-}" = hook ]; then
  case "${2:-}" in
    guard)
      reg=${FOREMAN_REGISTRY:-}
      # shellcheck disable=SC2088  # a literal ~ in FOREMAN_REGISTRY, expanded as config.py does
      case "$reg" in "~") reg=${HOME:-} ;; "~/"*) reg=${HOME:-}/${reg#"~/"} ;; esac
      if [ -z "$reg" ] && [ -n "${HOME:-}" ]; then reg=$HOME/.config/foreman/projects.toml; fi
      if [ -n "$reg" ] && [ -e "$reg" ]; then
        echo "foreman blocked this call: its guard (and the owner's never-without-me list) cannot run." \
          "$why. $how Until then $blocks ($reg)." >&2
        exit 2
      fi
      echo "foreman: $why; no foreman registry, so the guard lets this command pass. $how" >&2
      exit 0
      ;;
    who)
      ev=""
      while IFS= read -r line || [ -n "$line" ]; do ev="$ev$line"; done
      case "$ev" in *'"source":"compact"'*|*'"source": "compact"'*) exit 0 ;; esac
      printf '{"systemMessage": "%s", "hookSpecificOutput": {"hookEventName": "SessionStart", %s}}\n' \
        "$why: its hooks are off and $blocks. $how" \
        "\"additionalContext\": \"foreman cannot run in this session: $why; $blocks. The fix is the owner's: $how\""
      exit 0
      ;;
  esac
  echo "foreman: $why; hook ${2:-} skipped. $how" >&2
  exit 0
fi
echo "$why. $how" >&2
exit 1
